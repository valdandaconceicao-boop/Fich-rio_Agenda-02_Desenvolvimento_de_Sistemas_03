<?xml version="1.0" encoding="utf-8" ?>
<!-- Tela de Cadastro de Novo Produto (Design AAA Slim & Elegante) -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.NovoProduto"
             Title="Novo Produto"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F0F12}">

    <!-- Botão de Salvar no canto superior direito da barra de navegação -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Salvar" Clicked="ToolbarItem_Clicked" />
    </ContentPage.ToolbarItems>

    <!-- ScrollView para garantir fluidez ao abrir o teclado -->
    <ScrollView>
        <VerticalStackLayout Padding="20,16" Spacing="16">
            
            <Label Text="Cadastrar Produto"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                   HorizontalOptions="Center" />

            <!-- Card Slim Padronizado (Squircle: RoundRectangle 16) -->
            <Border StrokeShape="RoundRectangle 16"
                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#27272A}"
                    StrokeThickness="1"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#18181B}"
                    Padding="20">
                <VerticalStackLayout Spacing="16">
                    
                    <!-- Campo Descrição -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Descrição do Produto"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#475569, Dark=#CBD5E1}" />
                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#334155}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#27272A}"
                                Padding="12,0">
                            <Entry x:Name="txt_descricao"
                                   Placeholder="Ex: Arroz Tipo 1 - 5kg"
                                   PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#71717A}"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                                   ClearButtonVisibility="WhileEditing" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Campo Quantidade -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Quantidade"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#475569, Dark=#CBD5E1}" />
                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#334155}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#27272A}"
                                Padding="12,0">
                            <Entry x:Name="txt_quantidade"
                                   Placeholder="Ex: 2"
                                   PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#71717A}"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                                   Keyboard="Numeric" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Campo Preço Unitário -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Preço Unitário (R$)"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#475569, Dark=#CBD5E1}" />
                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#334155}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#27272A}"
                                Padding="12,0">
                            <Entry x:Name="txt_preco"
                                   Placeholder="Ex: 25.50"
                                   PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#71717A}"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                                   Keyboard="Numeric" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Botão Salvar (Verde Moderno com Cantos Arredondados) -->
                    <Button Text="Salvar Produto"
                            Margin="0,8,0,0"
                            BackgroundColor="#10B981"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="15"
                            CornerRadius="14"
                            HeightRequest="50"
                            Clicked="Button_Clicked_Salvar" />

                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
