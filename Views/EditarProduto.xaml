<?xml version="1.0" encoding="utf-8" ?>
<!-- Tela de Edição e Exclusão de Produto (Design AAA Slim & Elegante) -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.EditarProduto"
             Title="Editar Produto"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F0F12}">

    <!-- Botão de Excluir rápido no canto superior direito -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Excluir" Clicked="ToolbarItem_Clicked_Excluir" />
    </ContentPage.ToolbarItems>

    <!-- ScrollView para garantir fluidez ao abrir o teclado -->
    <ScrollView>
        <VerticalStackLayout Padding="20,16" Spacing="16">
            
            <Label Text="Alterar Produto"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                   HorizontalOptions="Center" />

            <!-- Card Slim Padronizado (Squircle: RoundRectangle 16) -->
            <Border StrokeShape="RoundRectangle 16"
                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#27272A}"
                    StrokeThickness="1"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#18181B}"
                    Padding="20">
                <VerticalStackLayout Spacing="16">
                    
                    <!-- ID do produto em Badge Discreta -->
                    <Border BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#27272A}"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="0"
                            Padding="10,4"
                            HorizontalOptions="Start">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="ID:"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#A1A1AA}" />
                            <Label x:Name="lbl_id"
                                   Text="0"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Campo Descrição -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Descrição do Produto"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#475569, Dark=#CBD5E1}" />
                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#334155}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#27272A}"
                                Padding="12,0">
                            <Entry x:Name="txt_descricao"
                                   Placeholder="Ex: Arroz Tipo 1 - 5kg"
                                   PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#71717A}"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                                   ClearButtonVisibility="WhileEditing" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Campo Quantidade -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Quantidade"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#475569, Dark=#CBD5E1}" />
                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#334155}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#27272A}"
                                Padding="12,0">
                            <Entry x:Name="txt_quantidade"
                                   Placeholder="Ex: 2"
                                   PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#71717A}"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                                   Keyboard="Numeric" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Campo Preço Unitário -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Preço Unitário (R$)"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#475569, Dark=#CBD5E1}" />
                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#334155}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#27272A}"
                                Padding="12,0">
                            <Entry x:Name="txt_preco"
                                   Placeholder="Ex: 25.50"
                                   PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#71717A}"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                                   Keyboard="Numeric" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Botão Atualizar (Azul Moderno com Cantos Arredondados) -->
                    <Button Text="Atualizar Produto"
                            Margin="0,8,0,0"
                            BackgroundColor="#2563EB"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="15"
                            CornerRadius="14"
                            HeightRequest="50"
                            Clicked="Button_Clicked_Atualizar" />

                    <!-- Botão Excluir (Vermelho Coral com Cantos Arredondados) -->
                    <Button Text="Excluir Produto"
                            BackgroundColor="#EF4444"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="15"
                            CornerRadius="14"
                            HeightRequest="50"
                            Clicked="Button_Clicked_Excluir" />

                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
